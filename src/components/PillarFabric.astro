---
interface Props { mode: 'think' | 'entangle' | 'fluctuate' | 'move' }
const { mode } = Astro.props;
---
<canvas class="pillar-fabric" data-mode={mode} aria-hidden="true"></canvas>
<script is:inline>
(() => {
 const canvas=document.querySelector('.pillar-fabric'),ctx=canvas?.getContext('2d');if(!ctx)return;
 const hero=canvas.parentElement, motion=matchMedia('(prefers-reduced-motion: reduce)');
 let w=0,h=0,frame=0,visible=true,last=0;
 function draw(ms){
 ctx.clearRect(0,0,w,h);
 const t=motion.matches?0:ms*.00035,cols=w<700?34:65,rows=w<700?23:34,points=[];
 const fade=Math.max(.12,1-Math.max(0,scrollY)/(h*.9));
 const mode=canvas.dataset.mode;
 // Several roaming centers intermittently align into a collective flow.
 const phase=t*.95, cohesion=Math.pow(.5+.5*Math.sin(phase*.64),2.4);
 const gx=.72+.09*Math.sin(phase*.38),gy=.51+.16*Math.cos(phase*.46);
 const clusters=Array.from({length:5},(_,k)=>{
 const angle=k*Math.PI*2/5+phase*.42;
 const spread=.22-.135*cohesion;
 return [gx+spread*Math.cos(angle)+.035*Math.sin(phase*(.73+k*.11)+k),gy+spread*1.45*Math.sin(angle)+.045*Math.cos(phase*(.81+k*.09)+k),.65+.35*Math.sin(phase*.9+k*1.8)];
 });
 for(let j=0;j<rows;j++){const row=[];for(let i=0;i<cols;i++){
 let x=i/(cols-1),y=j/(rows-1),dx=0,dy=0;
 if(mode==='think'){
 const aspect=w/Math.max(h,1);
 let vx=0,vy=0,weight=0;
 for(const [cx,cy,strength] of clusters){
 const a=(cx-x)*aspect,b=cy-y,r2=a*a+b*b;
 const k=Math.exp(-r2/.085)*(.65+.35*strength);
 // Local attraction plus tangential flow; overlap blends neighboring clusters.
 vx+=k*(a*.74-b*.58);vy+=k*(b*.74+a*.58);weight+=k;
 }
 const norm=Math.max(1,weight);
 const envelope=Math.exp(-((x-gx)**2*aspect*aspect+(y-gy)**2)/.28);
 const wave=Math.sin(x*17+y*13-phase*2.2);
 dx=vx/norm/aspect+.022*envelope*wave*(1-cohesion*.65);
 dy=vy/norm+.045*envelope*Math.sin(x*14-y*12-phase*1.6)*(1-cohesion*.65);
 }
 if(mode==='entangle'){
 const envelope=Math.exp(-Math.pow((x-.24)/.15,2))+Math.exp(-Math.pow((x-.82)/.15,2));
 dy=.095*envelope*Math.sin(y*19+t)*Math.cos(y*5);dx=.025*envelope*Math.cos(y*16+t);
 }else if(mode==='fluctuate'){
 dy=.035*Math.sin(x*37+y*17+t*2)+.025*Math.sin(x*21-y*26-t*1.4)+.04*Math.sin(x*11+t)*Math.cos(y*13+t);
 dx=.015*Math.sin(x*29+y*21-t);
 }else if(mode==='move'){
 // A traveling throat: radial compression and twist, with a soft trailing wake.
 const cx=.69+.22*Math.sin(t*.85),cy=.51+.19*Math.sin(t*1.15+.7);
 const aspect=w/Math.max(h,1),a=(x-cx)*aspect,b=y-cy;
 const radius=Math.hypot(a,b),sigma=.25;
 const influence=Math.exp(-radius*radius/(2*sigma*sigma));
 const twist=1.05*influence,compression=1-.83*influence;
 const px=(a*Math.cos(twist)-b*Math.sin(twist))*compression;
 const py=(a*Math.sin(twist)+b*Math.cos(twist))*compression;
 dx=(px-a)/aspect;dy=py-b;
 dy+=.035*Math.sin(radius*24-t*2)*Math.exp(-radius*radius/.22);

 }
 row.push([w*(x+dx)+(mode==='move'?3:12)*Math.sin(y*11+t),h*(y+dy)+(mode==='move'?4:20)*Math.sin(x*13+y*8+t)*x]);
 }points.push(row)}
 ctx.lineWidth=.75;ctx.strokeStyle='rgba(68,66,61,'+((mode==='think'?.32:.24)*fade)+')';
 for(const row of points){ctx.beginPath();row.forEach((p,i)=>i?ctx.lineTo(...p):ctx.moveTo(...p));ctx.stroke()}
 for(let i=0;i<cols;i++){ctx.beginPath();points.forEach((row,j)=>j?ctx.lineTo(...row[i]):ctx.moveTo(...row[i]));ctx.stroke()}
 for(let j=2;j<rows;j+=4)for(let i=3;i<cols;i+=5){const p=points[j][i];ctx.beginPath();ctx.arc(...p,1.2,0,Math.PI*2);ctx.fillStyle='rgba(68,66,61,'+(.38*fade)+')';ctx.fill()}
 if(!motion.matches)for(let n=0;n<(mode==='think'?9:4);n++){const i=mode==='entangle'?Math.floor((n%2?.82:.24)*(cols-1)):Math.floor(((t*.23+n*.27)%1)*(cols-1)),j=mode==='entangle'?Math.floor((.25+Math.floor(n/2)*.4)*(rows-1)):mode==='think'?Math.floor((.12+(n*.137)% .78)*(rows-1)):Math.floor(rows*(.2+n*.18));ctx.beginPath();ctx.arc(...points[j][i],2,0,Math.PI*2);ctx.fillStyle='rgba(181,76,53,'+(.7*fade)+')';ctx.fill()}
 }
 function size(){const r=hero.getBoundingClientRect(),d=Math.min(devicePixelRatio||1,1.7);w=r.width;h=r.height;canvas.width=Math.round(w*d);canvas.height=Math.round(h*d);ctx.setTransform(d,0,0,d,0,0);draw(0)}
 function tick(t){if(!visible||motion.matches){frame=0;return}if(t-last>33){draw(t);last=t}frame=requestAnimationFrame(tick)}
 function start(){if(!frame&&visible&&!motion.matches)frame=requestAnimationFrame(tick)}
 new ResizeObserver(size).observe(hero);
 new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;if(visible)start();else{cancelAnimationFrame(frame);frame=0}}).observe(hero);
 motion.addEventListener('change',()=>{cancelAnimationFrame(frame);frame=0;draw(0);start()});
 size();start();
})();
</script>
