---
import { frontierPath, frontierWorlds } from '../data/enchantedV2';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const preview = `${base}/preview/enchanted-v2/`;
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <a class="wordmark" href={home} aria-label="Vijoy Pandey — Home">Vijoy<span class="wordmark-dot">.</span></a>
  <nav class="site-nav" aria-label="Main navigation">
    <details>
      <summary>Thesis <span aria-hidden="true">⌄</span></summary>
      <div class="nav-menu">
        <a href={home}>Overview</a>
        {frontierWorlds.map((world) => <a href={`${base}${frontierPath(world.slug)}`}>{world.name}</a>)}
      </div>
    </details>
    <details>
      <summary>About <span aria-hidden="true">⌄</span></summary>
      <div class="nav-menu nav-menu--right">
        <a href={`${preview}about-me/`}>Personal</a>
        <a href={`${preview}how-i-work/`}>Work</a>
        <a href={`${base}/#contact`}>Contact</a>
      </div>
    </details>
  </nav>
</header>
