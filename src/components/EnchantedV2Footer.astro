---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
---

<footer class="site-footer">
  <div class="footer-top">
    <a class="footer-brand" href={home}>Vijoy<span>.</span></a>
    <p>Computing beyond the individual node.</p>
  </div>
  <nav class="footer-links" aria-label="Explore">
    <span class="footer-row-label">Explore</span>
    <a href={`${base}/about/personal/`}>Personal</a>
    <a href={`${base}/about/work/`}>Work</a>
    <a href="mailto:vijoy.external@gmail.com">Contact</a>
  </nav>
  <nav class="footer-elsewhere" aria-label="Elsewhere">
    <span class="footer-row-label">Elsewhere</span>
    <a href="https://vijoypandey.substack.com/">Coherent Cognition ↗</a>
    <a href="https://www.linkedin.com/in/vijoy">LinkedIn ↗</a>
    <a href="https://www.twitter.com/vijoy">Twitter / X ↗</a>
    <!-- Add verified X, Outshift, and podcast URLs here -->
  </nav>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} Vijoy Pandey</span><a href={home}>Back to the beginning ↑</a></div>
</footer>

<a class="back-to-top" href="#" aria-label="Back to top">
  ↑
</a>

<script>
  const backToTop = document.querySelector<HTMLElement>('.back-to-top');

  if (backToTop) {
    const updateVisibility = () => {
      backToTop.classList.toggle('is-visible', window.scrollY > 500);
    };

    window.addEventListener('scroll', updateVisibility, { passive: true });
    updateVisibility();
  }
</script>
