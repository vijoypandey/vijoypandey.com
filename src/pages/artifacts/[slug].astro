---
import { getCollection, render } from 'astro:content';
import EnchantedV2Header from '../../components/EnchantedV2Header.astro';
import EnchantedV2Footer from '../../components/EnchantedV2Footer.astro';
import '../../styles/enchanted-v2.css';
import '../../styles/frontier-essay.css';
export async function getStaticPaths() {
  const entries = await getCollection('artifacts');
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const frontierLinks = { think: 'emergent-superintelligence', entangle: 'quantum-computing', move: 'physical-ai', fluctuate: 'boltzmann-computing' };
---
<!doctype html>
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={entry.data.description} />
    <link rel="canonical" href={new URL(`${base}/artifacts/${entry.id}/`, Astro.site).href} />
    <title>{entry.data.title} — Vijoy Pandey</title>
  </head>
  <body class="enchanted-v2 frontier-essay">
    <EnchantedV2Header />
    <main id="main">
      <header class="frontier-opening artifact-detail">
        <p class="frontier-kicker">{entry.data.type} {entry.data.date && <span>— {entry.data.date.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric', timeZone:'UTC' })}</span>}</p>
        <h1>{entry.data.title}</h1>
        <p class="frontier-lede">{entry.data.description}</p>
        {entry.data.url && <p class="artifact-source"><a class="text-link" href={entry.data.url} rel="noopener noreferrer" target="_blank">Read or listen at the original source <span aria-hidden="true">↗</span></a></p>}
      </header>
      <article class="frontier-prose artifact-body"><Content /></article>
      <nav class="frontier-end" aria-label="Related frontier">
        <span>Related inquiry</span>
        {entry.data.frontiers.map((tag) => <a href={`${base}/${frontierLinks[tag]}/`}>{tag === 'think' ? 'Emergent Superintelligence' : tag === 'entangle' ? 'Quantum Computing' : tag === 'move' ? 'Physical AI' : 'Boltzmann Computing'} ↗</a>)}
      </nav>
    </main>
    <EnchantedV2Footer />
  </body>
</html>
<style>
.artifact-detail h1{font-size:clamp(2.6rem,6vw,6rem);line-height:1.08;overflow-wrap:break-word;max-width:18ch;margin-top:2.5rem;}
.artifact-source{margin-top:2rem;}
.artifact-body :global(p){line-height:1.75;margin:1.2rem 0;color:#4c4841;}
.artifact-body :global(a){text-underline-offset:3px;}
.artifact-body :global(h2){font-size:2rem;margin-top:3rem;}
.artifact-body :global(img){max-width:100%;height:auto;}
.artifact-body :global(blockquote){border-left:2px solid #987962;padding-left:1.5rem;}
</style>