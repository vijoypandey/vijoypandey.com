/* A pinned image theatre: four editorial reveals, one continuous scroll space. */
.problems{height:250svh;min-height:0;padding:0;display:block;color:#25292b;isolation:isolate}
.gallery-pin{height:100svh;position:sticky;top:0;overflow:hidden;display:grid;align-items:center;padding:90px 7vw 74px;z-index:4}
