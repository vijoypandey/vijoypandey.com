.reveal{opacity:.3;transform:translateY(32px);transition:opacity .8s,transform .8s}.reveal.seen{opacity:1;transform:none}footer{position:relative;z-index:3;background:#191c1e;border-top:1px solid #ffffff44;padding:34px 7vw 90px;display:flex;justify-content:space-between;font-size:12px;color:#afb4b8}
