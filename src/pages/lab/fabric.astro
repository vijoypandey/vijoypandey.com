/* Editorial display face and quiet sans text. System stacks keep the study self-contained. */
:root{--display:'Iowan Old Style','Baskerville','Palatino Linotype',Georgia,serif;--text:'Avenir Next',Avenir,'Helvetica Neue',Arial,sans-serif}
body{font-family:var(--text);-webkit-font-smoothing:antialiased}
.brand,.scene h1,.scene h2,.gallery-copy h2,.art-label,.frontiers strong{font-family:var(--display);font-weight:400;letter-spacing:-.045em}
.scene h1,.scene h2{line-height:1.07}.scene h1{max-width:11ch}.scene h2{max-width:12ch}
.gallery-copy h2{line-height:1.08}.art-label{font-family:var(--display)}
.eyebrow,.chapter,.nav,.steps,.aside,.next,.art-id,.art-note,.gallery-status{font-family:var(--text);font-weight:600}
.scene .sub,.gallery-copy .sub{font-family:var(--text);font-weight:400;letter-spacing:-.015em}
.chapter-scene{height:155svh;min-height:0;padding:0;display:block}
.chapter-pin{position:sticky;top:0;height:100svh;min-height:650px;padding:105px 7vw 85px;display:grid;grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr);gap:5vw;align-items:center;overflow:hidden}
.chapter-pin .copy{position:relative;z-index:5;max-width:650px}
.chapter-pin .chapter{margin-bottom:24px}
.chapter-pin h2{font-size:clamp(48px,5.7vw,84px)}
.chapter-visual{position:relative;height:min(68svh,640px);min-height:430px;overflow:hidden;border:1px solid #8f969a66;background:linear-gradient(145deg,#35393d7a,#181b1e8c);box-shadow:0 26px 95px #11141677;isolation:isolate}
.chapter-visual::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 58% 40%,#aeb4b522,transparent 57%);pointer-events:none}
.chapter-visual svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible;transform:translateY(calc(var(--chapter-shift,0) * -32px)) scale(calc(1 + var(--chapter-shift,0) * .045));transition:transform .15s linear}
.chapter-visual path,.chapter-visual line,.chapter-visual circle,.chapter-visual ellipse,.chapter-visual rect{vector-effect:non-scaling-stroke}
.visual-top,.visual-bottom{position:absolute;z-index:2;left:24px;right:24px;display:flex;justify-content:space-between;gap:12px;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:#c4c9cb}
.visual-top{top:24px}.visual-bottom{bottom:24px;padding-top:14px;border-top:1px solid #a6acae65}
.visual-bottom span:last-child{color:#a9afb2}
.chapter-visual .accent{stroke:#d7dddf}.chapter-visual .secondary{stroke:#a1aaae}.chapter-visual .node{fill:#d6dcde}.chapter-visual .ghost{stroke:#7f898e}
.chapter-visual svg *{fill:none;stroke-width:1.2}
.chapter-visual svg .node{stroke:none}
.physics .chapter-visual{background:radial-gradient(circle at 50% 50%,#59616680,#24282c 62%,#171a1d)}
.world .chapter-visual{background:linear-gradient(150deg,#353a3d,#1a1e21 72%)}
.chapter-scene .sub{max-width:31ch}
#ambition{z-index:5;background:transparent}
#ambition::after{content:none}
@media(prefers-reduced-motion:reduce){#ambition::after{-webkit-backdrop-filter:none;backdrop-filter:none}}
