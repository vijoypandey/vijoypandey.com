:root{--vermilion:#B54C35}.brand-dot{display:inline-block;width:.19em;height:.19em;border-radius:50%;background:var(--vermilion);margin-left:.075em;vertical-align:.025em}.steps a.on{color:var(--vermilion)}.steps a.on:after{background:var(--vermilion)}.chapter:before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--vermilion);margin-right:10px;vertical-align:2px}.chapter-links .link-arrow,.frontiers .link-arrow{color:var(--vermilion)}
