.art-panel::before{content:"";position:absolute;width:84%;height:120%;top:-35%;right:-18%;border:1px solid #f1f2f25a;border-radius:50%;transform:rotate(-34deg);pointer-events:none}
.art-panel::after{content:"";position:absolute;width:90%;height:80%;bottom:-38%;left:-25%;border:1px solid #555a6066;border-radius:50%;transform:rotate(25deg);pointer-events:none}
.art-panel[data-art="0"]{background:radial-gradient(ellipse at 74% 36%,#d0d2d2,#a2a6a8 48%,#73787c)}
.art-panel[data-art="1"]{background:radial-gradient(ellipse at 30% 70%,#d2d3d2,#a9adae 44%,#777d81)}
