/* Chapter-specific accents: a restrained color vocabulary on neutral paper. */
.intelligence{--chapter-dot:#286C65;--chapter-emphasis:#456B63}
.physics{--chapter-dot:#AE802F;--chapter-emphasis:#80632F}
.world{--chapter-dot:#3B55A0;--chapter-emphasis:#53658A}
.chapter-scene .chapter:before{background:var(--chapter-dot)}
.chapter-scene .scaling-thread{color:var(--chapter-emphasis)}
.chapter-scene .chapter-links .link-arrow{color:var(--chapter-dot)}
:root{--text:'Roboto','Helvetica Neue',Arial,sans-serif}
body{font-weight:300}
.scene .sub,.gallery-copy .sub,.problems-intro,.problem-card-copy>p:last-child,.history-bridge,.scene .scaling-thread,.history-bridge .scaling-thread,.activity-list a{font-weight:300;letter-spacing:normal}
.scene .sub,.gallery-copy .sub,.problems-intro,.problem-card-copy>p:last-child,.history-bridge{color:#504d48}
.scene .scaling-thread,.history-bridge .scaling-thread{color:#353432}
.intelligence{--chapter-emphasis:#34574f}
.physics{--chapter-emphasis:#6e5429}
.world{--chapter-emphasis:#435577}
.chapter-scene .scaling-thread{color:var(--chapter-emphasis)}
.eyebrow,.chapter,.nav,.steps,.aside,.next,.art-id,.art-note,.gallery-status,.chapter-links,.problem-index,.image-placeholder span{font-weight:500}
/* Editorial headline tones and platform-independent navigation details. */
.scene h1 em,.scene h2 em,.problems-content h2 em{font-style:normal;font-weight:inherit;color:#82735e}
.steps a{display:flex;flex-direction:column;justify-content:space-between;min-width:0}
.steps a:after{flex-shrink:0}
.link-arrow{display:inline-block;position:relative;width:.72em;height:.72em;vertical-align:.02em;margin-left:.15em;color:inherit}
.link-arrow:before{content:"";position:absolute;right:0;top:0;width:.43em;height:.43em;border-top:1px solid currentColor;border-right:1px solid currentColor}
.link-arrow:after{content:"";position:absolute;left:0;bottom:0;width:.91em;height:1px;background:currentColor;transform:rotate(-45deg);transform-origin:left center}
@media(max-width:800px){.steps{align-items:stretch;gap:5px;background:#eee9def2;padding:7px 0 5px;box-shadow:0 -6px 14px #eee9de88}.steps a{font-size:7px;line-height:1.2;letter-spacing:0;white-space:nowrap}.steps a:after{margin-top:8px}.scene>.next{bottom:92px}.inquiry{min-height:0;padding-bottom:65px}.activity-lab{padding-top:65px}}
@media(max-width:360px){.steps a{font-size:6px}}
.steps{background:rgba(238,233,222,.8);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);padding:8px 0 5px;box-shadow:0 -5px 15px rgba(238,233,222,.35)}
.convergence-plate.artwork-video{padding:0;aspect-ratio:16/9;border-radius:8px;overflow:hidden}
.personal-grounding{max-width:800px;margin:clamp(32px,5vw,64px) auto 0;text-align:left;color:#504d48;font-family:var(--text);font-weight:300;font-size:clamp(16px,1.45vw,20px);line-height:1.6}
.personal-grounding p{margin:0 0 .8em}
.personal-grounding p:last-child{margin-bottom:0}
#ambition .personal-grounding{max-width:650px;margin:clamp(22px,3vw,36px) 0 0;padding-top:clamp(16px,2vw,24px);border-top:1px solid #82735e40;font-size:clamp(14px,1.2vw,17px);line-height:1.5;text-align:left}
#ambition .preface-signature{font-family:Georgia,serif;font-style:italic;color:#82735e;font-size:21px;margin:12px 0 0}
.chapter-reading{max-width:520px;margin:18px 0;border-top:1px solid #82735e40;padding-top:12px;display:grid;gap:10px}
.chapter-reading .reading-label{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#82735e;margin:0 0 5px;font-weight:500}
.chapter-reading a{display:block;font-size:14px;line-height:1.35;color:#504d48;margin:4px 0;font-weight:400}
.chapter-reading a:hover{text-decoration:underline}
.chapter-reading small{display:block;color:#82735e;font-size:11px;font-weight:300}
.chapter-pin{height:auto;min-height:100svh;overflow:visible}
@media(max-height:850px) and (min-width:761px){.chapter-pin{position:relative}.chapter-scene{height:auto}}
.chapter-media{min-width:0;width:100%;align-self:center}
.chapter-media .chapter-reading{max-width:none;margin:16px 0 0;padding-top:12px;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 24px;border-color:#77736b40}
.chapter-media .chapter-reading>div:only-child{grid-column:1/-1}
.chapter-scene.intelligence,.chapter-scene.physics,.chapter-scene.world{--chapter-emphasis:#504e4a;--chapter-dot:#77746e}
.chapter-scene .scaling-thread{color:#504e4a}
.chapter-scene .chapter-links .link-arrow{color:#77746e}
.chapter-scene .chapter:before{background:#77746e}
.chapter-scene.intelligence{background:#e9e9e945}
.chapter-scene.physics{background:#dedede45}
.chapter-scene.world{background:#d4d4d445}
.chapter-media .reading-label,.chapter-media .chapter-reading small{color:#696762}
#ambition .preface-signature{font-style:normal}
@media(max-width:760px){.chapter-media .chapter-reading{grid-template-columns:1fr;gap:10px}}
/* Shared editorial grid: align section headings, prose and media to one outer rail.
   Keep existing reading measures; do not center narrow text blocks independently. */
:root{--editorial-gutter:7vw;--editorial-max:1510px}
.scene:not(.chapter-scene),.problems-static{padding-inline:max(var(--editorial-gutter),calc((100% - var(--editorial-max))/2))}
.chapter-pin{padding-inline:max(var(--editorial-gutter),calc((100% - var(--editorial-max))/2));grid-template-columns:minmax(0,.82fr) minmax(0,1.18fr)}
.problems-content{width:100%;max-width:none;margin:0}
.problems-content>.eyebrow,.problems-content>h2,.problems-intro,.history-bridge{margin-inline:0;text-align:left}
.problems-intro{max-width:780px}
.convergence{align-items:flex-start;text-align:left}
.convergence .copy{width:min(100%,850px)}
.convergence h2,.convergence .sub{margin-inline:0}
.convergence-plate{margin-inline:0}
.chapter-pin{align-items:start}
.chapter-media{align-self:start}
@media(min-width:801px){.chapter-media{margin-top:36px}}
@media(max-width:800px){:root{--editorial-gutter:24px}.chapter-media{margin-top:0}}
.static-artwork img{display:block;width:100%;height:100%;object-fit:contain;background:#eee9de}
.activity-profile{position:relative;z-index:4;font-size:13px;color:#696762;margin-top:28px}
</style>
</head>
<body>
<canvas id="fabric" aria-hidden="true"></canvas><div class="shade" aria-hidden="true"></div>
<header><a href="/" class="brand" aria-label="Vijoy home">Vijoy<span class="brand-dot" aria-hidden="true"></span></a><div class="nav"><a href="/">Current site</a><span class="lab">Design study / 4.2</span></div></header>
<nav class="steps" aria-label="Explore sections"><a href="#ambition" class="on">01 Ambition</a><a href="#problems">02 Problems</a><a href="#intelligence">03 Think</a><a href="#physics">04 Physics</a><a href="#world">05 World</a><a href="#convergence">06 Together</a><a href="#activity">07 Activity</a><a href="#frontiers">08 Frontiers</a></nav>
<main>
<section class="scene" id="ambition" data-mode="0"><div class="copy reveal seen"><p class="eyebrow">Civilization-Scale Computing</p><h1>What will it take to solve <em>the harder problems?</em></h1><p class="sub">From discovering medicines and materials to understanding the universe and modeling complex systems.</p><p class="aside">Beyond the Bit / What comes after the individual?</p><div class="personal-grounding">
      <p>These are questions I have been drawn to throughout my career as a technologist. My thinking has been shaped by many colleagues and friends, and I am fortunate to work with some extraordinary and visionary individuals who help explore and expand these ideas and bring some of them to life.</p>
      <p>Much of what follows draws on their contributions, the work of the wider technology community, and my own thinking about where computing is headed.</p>
    <p class="preface-signature">Vijoy.</p></div></div><p class="next">Scroll to explore ↓</p></section>
<section class="problems problems-static" id="problems" data-mode="1" aria-labelledby="problems-title">
  <div class="problems-content">
    <p class="eyebrow">The problems</p>
    <h2 id="problems-title">Problems that matter <em>to humanity.</em></h2>
    <p class="problems-intro">Many of the hardest problems we want to solve involve exploring enormous spaces of possibilities, searching for solutions that satisfy multiple, often competing constraints. The sheer size and complexity of these spaces challenge the limits of what we can practically compute.</p>
    <div class="problems-cards">
      <article class="problem-card">
        <div class="problem-card-copy"><p class="problem-index">01 / Discovery</p><h3>Drugs and materials</h3><p>Searching molecular and material configurations for desirable properties.</p></div>
        <div class="image-placeholder artwork-video static-artwork"><img src="/images/fabric/discovery.jpeg" alt="Drug and materials discovery illustration" width="1600" height="900" decoding="async" loading="lazy"></div>
      </article>
      <article class="problem-card">
        <div class="problem-card-copy"><p class="problem-index">02 / Understanding</p><h3>The universe</h3><p>Modeling physical systems and their evolution across vast spatial and temporal scales.</p></div>
        <div class="image-placeholder artwork-video static-artwork"><img src="/images/fabric/understanding.jpeg" alt="Universe illustration" width="1600" height="900" decoding="async" loading="lazy"></div>
      </article>
      <article class="problem-card">
        <div class="problem-card-copy"><p class="problem-index">03 / Complexity</p><h3>Global systems</h3><p>Optimizing interconnected systems, from logistics to financial markets, under competing objectives and uncertainty.</p></div>
        <div class="image-placeholder artwork-video static-artwork"><img src="/images/fabric/complexity.jpeg" alt="Interconnected global systems illustration" width="1600" height="900" decoding="async" loading="lazy"></div>
      </article>
    </div>
    <p class="history-bridge">For eighty years, we have made extraordinary progress computing with bits. We have scaled computation along three axes: <span class="scaling-thread">algorithmically, through better ways of solving problems; vertically, through more powerful machines; and horizontally, through many machines working together as one system.</span> Now the nature of computation itself is changing in three directions.</p>
  </div>
</section>
<section class="scene chapter-scene intelligence" id="intelligence" data-mode="2"><div class="chapter-pin"><div class="copy reveal"><p class="chapter">01 / Workloads</p><h2>Computing becomes <em>intelligent.</em></h2><p class="sub">Workloads are evolving from programmed logic toward learned, probabilistic, and agentic systems. Specialization allows us to distribute reasoning across different models and agents, opening up the possibility of emergent intelligence.</p><p class="sub grounding">Specialized AI agents are already collaborating on scientific and enterprise problems, but experiments reveal new failure modes when individual reasoning becomes collective.</p><p class="sub"><span class="scaling-thread">How do we move from individual reasoning to collective intelligence? Connected systems must share richer forms of state: meaning, knowledge, context, and intent.</span></p><div class="chapter-links"><a href="/emergent-superintelligence/">THINK / Collective Intelligence <span class="link-arrow" aria-hidden="true"></span></a></div></div><div class="chapter-media"><div class="chapter-visual artwork-video"><video data-artwork src="/videos/fabric/collective.mp4" muted playsinline preload="metadata" aria-label="Collective intelligence illustration"></video></div><div class="chapter-reading">{reading.intelligence.articles.length > 0 && <div><p class="reading-label">From Coherent Cognition</p>{reading.intelligence.articles.map(item => <a href={item.url}>{item.title} <span class="link-arrow" aria-hidden="true"></span></a>)}</div>}{reading.intelligence.technical.length > 0 && <div><p class="reading-label">Related technical work</p>{reading.intelligence.technical.map(item => <a href={item.url}>{item.title} <span class="link-arrow" aria-hidden="true"></span><small>{item.credit}</small></a>)}</div>}</div></div></div></section>
<section class="scene chapter-scene physics" id="physics" data-mode="3"><div class="chapter-pin"><div class="copy reveal"><p class="chapter">02 / Substrates</p><h2>Computing embraces <em>physics.</em></h2><p class="sub">There is an impedance mismatch between the problems we want to solve, the workloads tackling them, and what conventional compute can provide efficiently at scale. Why should we force-fit inherently probabilistic and exploratory workloads onto deterministic binary infrastructure?</p><p class="sub grounding">Researchers have demonstrated quantum operations across separate processors, while emerging probabilistic hardware exploits physical fluctuations to perform computation.</p><p class="sub">Quantum phenomena, thermodynamic fluctuations, and oscillator dynamics offer distinct computational mechanisms. <span class="scaling-thread">Scaling them means preserving useful coherence, distributions, and correlations across system boundaries.</span></p><div class="chapter-links"><a href="/quantum-computing/">ENTANGLE / Quantum <span class="link-arrow" aria-hidden="true"></span></a><a href="/physics-based-computing/">FLUCTUATE / Physics-Based Computing <span class="link-arrow" aria-hidden="true"></span></a></div></div><div class="chapter-media"><div class="chapter-visual artwork-video"><video data-artwork src="/videos/fabric/physics.mp4" muted playsinline preload="metadata" aria-label="Physical computation illustration"></video></div><div class="chapter-reading">{reading.physics.articles.length > 0 && <div><p class="reading-label">From Coherent Cognition</p>{reading.physics.articles.map(item => <a href={item.url}>{item.title} <span class="link-arrow" aria-hidden="true"></span></a>)}</div>}{reading.physics.technical.length > 0 && <div><p class="reading-label">Related technical work</p>{reading.physics.technical.map(item => <a href={item.url}>{item.title} <span class="link-arrow" aria-hidden="true"></span><small>{item.credit}</small></a>)}</div>}</div></div></div></section>
<section class="scene chapter-scene world" id="world" data-mode="4"><div class="chapter-pin"><div class="copy reveal"><p class="chapter">03 / Embodiment</p><h2>Computing extends into <em>the physical world.</em></h2><p class="sub">And then, how do we unleash the power of this new software, new compute, and new sensing paradigms beyond the boundaries of the data center and the cloud, to do real work in the physical world?</p><p class="sub grounding">Learned world models, autonomous robotic systems, and distributed sensing are connecting computational reasoning with physical action, where geometry, motion, uncertainty and timing all matter.</p><p class="sub"><span class="scaling-thread">Connecting machines, sensors, and compute around a shared understanding of their environment could enable coordinated, safe physical action.</span></p><div class="chapter-links"><a href="/physical-ai/">MOVE / Physical AI <span class="link-arrow" aria-hidden="true"></span></a></div></div><div class="chapter-media"><div class="chapter-visual artwork-video"><video data-artwork src="/videos/fabric/physical.mp4" muted playsinline preload="metadata" aria-label="Physical AI illustration"></video></div><div class="chapter-reading">{reading.world.articles.length > 0 && <div><p class="reading-label">From Coherent Cognition</p>{reading.world.articles.map(item => <a href={item.url}>{item.title} <span class="link-arrow" aria-hidden="true"></span></a>)}</div>}{reading.world.technical.length > 0 && <div><p class="reading-label">Related technical work</p>{reading.world.technical.map(item => <a href={item.url}>{item.title} <span class="link-arrow" aria-hidden="true"></span><small>{item.credit}</small></a>)}</div>}</div></div></div></section>
<section class="scene convergence" id="convergence" data-mode="5"><div class="copy reveal"><p class="eyebrow">Civilization-Scale Computing</p><h2>Now imagine them <em>working together.</em></h2><p class="sub"><span class="scaling-thread">Imagine intelligent systems collaborating on scientific questions, drawing on specialized computational substrates to simulate and optimize, and testing their ideas in autonomous laboratories. Measurements feed back into the collective intelligence.</span></p><p class="sub grounding">AI systems are helping optimize quantum algorithms, while autonomous laboratories connect computational discovery with physical experimentation and feedback.</p><p class="sub">Together, these capabilities could expand what we can discover, understand, and build.</p></div><figure class="convergence-plate artwork-video"><video data-artwork src="/videos/fabric/together.mp4" muted loop playsinline preload="metadata" aria-label="Illustration of distinct computational systems working together"></video></figure></section>
<section class="scene activity-lab" id="activity"><div class="copy"><p class="eyebrow">A continuing record</p><h2>Recent <em>activity.</em></h2></div><div class="activity-list">{xActivity.map(item => <a href={item.url}><small>{item.date} / X</small>{item.title} <span class="link-arrow" aria-hidden="true"></span></a>)}</div><p class="activity-profile"><a href="https://x.com/vijoy">More observations on X / @vijoy <span class="link-arrow" aria-hidden="true"></span></a></p></section>
<section class="scene inquiry" id="frontiers" data-mode="6"><div class="copy reveal"><p class="eyebrow">Beyond the Bit / What comes after the individual?</p><h2>What state must <em>survive the boundary?</em></h2><p class="sub">Networks made it possible to scale classical computation beyond individual machines. Now the endpoints reason, fluctuate, entangle, and move. <span class="scaling-thread">What we must share or preserve across their boundaries is changing.</span> Much of my work is an exploration of what becomes possible when the boundaries of individual computational systems begin to dissolve.</p></div><div class="frontiers">
<a href="/emergent-superintelligence/"><small>Collective intelligence</small><strong>Think</strong><small>Explore frontier <span class="link-arrow" aria-hidden="true"></span></small></a>
<a href="/quantum-computing/"><small>Quantum computing</small><strong>Entangle</strong><small>Explore frontier <span class="link-arrow" aria-hidden="true"></span></small></a>
<a href="/physics-based-computing/"><small>Physics-based computing</small><strong>Fluctuate</strong><small>Explore frontier <span class="link-arrow" aria-hidden="true"></span></small></a>
<a href="/physical-ai/"><small>Physical AI</small><strong>Move</strong><small>Explore frontier <span class="link-arrow" aria-hidden="true"></span></small></a>
</div></section>

</main><footer><span>Fabric Lab / Experimental prototype</span><a href="/">Return to current website <span class="link-arrow" aria-hidden="true"></span></a></footer>
<script is:inline>
(function(){
const canvas=document.querySelector('#fabric'),ctx=canvas.getContext('2d');if(!ctx)return;
const scenes=Array.from(document.querySelectorAll('[data-mode]')),links=Array.from(document.querySelectorAll('.steps a'));
const reduced=window.matchMedia('(prefers-reduced-motion:reduce)');
const chapters=Array.from(document.querySelectorAll('.chapter-scene'));
let w=0,h=0,d=1,mode=0,visualMode=0,targetMode=0,scroll=0,target=0,frame=0;
function resize(){w=innerWidth;h=innerHeight;d=Math.min(devicePixelRatio||1,1.7);canvas.width=Math.round(w*d);canvas.height=Math.round(h*d);ctx.setTransform(d,0,0,d,0,0);if(reduced.matches)draw(0)}
function smoothstep(a,b,x){const v=Math.min(1,Math.max(0,(x-a)/(b-a)));return v*v*(3-2*v)}
function onscroll(){
 target=scrollY/Math.max(1,document.documentElement.scrollHeight-h);
 const at=scrollY+h*.55;
 mode=0;targetMode=0;
 scenes.forEach((el,i)=>{
   if(i===0)return;
   const distance=at-el.offsetTop;
   // Blend across a full viewport around each chapter boundary, never snap meshes.
   targetMode+=smoothstep(-h*.55,h*.55,distance);
   if(distance>=0)mode=i;
 });
 const activeLink=links.filter(el=>{const section=document.querySelector(el.getAttribute('href'));return section&&section.offsetTop<=at}).pop()||links[0];links.forEach(el=>el.classList.toggle('on',el===activeLink));
chapters.forEach(el=>{
  const travel=Math.max(1,el.offsetHeight-h);
  const progress=Math.min(1,Math.max(0,(scrollY-el.offsetTop)/travel));
  el.style.setProperty('--chapter-shift',String(reduced.matches?0:progress));
});
if(reduced.matches){scroll=target;visualMode=targetMode;draw(0)}
}
function draw(ms){
ctx.clearRect(0,0,w,h);
const t=reduced.matches?0:ms*.00032,p=scroll*17+t,cols=w<720?43:81,rows=w<720?24:32;
const amplitudes=[65,32,75,85,95,80,70],alphas=[.30,.28,.30,.30,.30,.30,.26];
const k=Math.min(6,Math.floor(visualMode)),next=Math.min(6,k+1),mix=smoothstep(0,1,visualMode-k);
const amp=amplitudes[k]*(1-mix)+amplitudes[next]*mix;
const alpha=alphas[k]*(1-mix)+alphas[next]*mix;
// One continuous mesh throughout. Its ink adapts to the lighter chapter:
// charcoal-gray filaments over gray; silver filaments over charcoal.
// Dim through the midpoint so the tonal shift never reads as a color snap.
const light=0;
const tone=67;
const visibleAlpha=alpha*.48;
let points=[];
for(let j=0;j<rows;j++){const row=[];for(let i=0;i<cols;i++){
const x=i/(cols-1),y=j/(rows-1);
const camera=1+.025*smoothstep(.10,.35,scroll)+.065*smoothstep(.45,.8,scroll);
const px=(w*(x*1.42-.18)-w*.52)*camera+w*.52+Math.sin(y*9+p*.55)*12 + Math.sin(x*5+y*4-t*.65)*7;
const a=Math.sin(x*11+y*6+p)+.35*Math.sin(x*24-y*10-t);
const b=Math.sin(x*16+p)*Math.cos(y*9-p*.7);
const c=Math.sin(x*28+p)*Math.sin(y*18-p);
const e=Math.sin(x*9+y*8+t)*Math.cos(x*4-y*7);
const behaviors=[a,a,b,c,e,(b+c+e)/3,a];const wave=behaviors[k]*(1-mix)+behaviors[next]*mix;
const py=h*(.27+y*.92)+wave*amp*(.48+y*.7)+Math.sin(x*6+y*3+p)*26;
row.push([px,(py-h*.56)*camera+h*.56]);
}points.push(row)}
ctx.strokeStyle='rgba('+Math.round(tone+5)+','+Math.round(tone+3)+','+Math.round(tone-2)+','+visibleAlpha+')';ctx.lineWidth=w<720?.6:.75;
for(let j=0;j<rows;j++){ctx.beginPath();points[j].forEach((pt,i)=>i?ctx.lineTo(pt[0],pt[1]):ctx.moveTo(pt[0],pt[1]));ctx.stroke()}
for(let i=0;i<cols;i++){ctx.beginPath();for(let j=0;j<rows;j++){const pt=points[j][i];j?ctx.lineTo(pt[0],pt[1]):ctx.moveTo(pt[0],pt[1])}ctx.stroke()}
for(let j=0;j<rows;j+=3)for(let i=0;i<cols;i+=5){const v=(Math.sin(i*.6+j*.8+p)+1)*.5,pt=points[j][i];ctx.beginPath();ctx.arc(pt[0],pt[1],v>.85?1.4:.65,0,Math.PI*2);ctx.fillStyle='rgba('+Math.round(tone+18)+','+Math.round(tone+15)+','+Math.round(tone+10)+','+((.12+v*.4)*(visibleAlpha/.23))+')';ctx.fill()}
// Rare warm pulses travel across the graphite mesh; keep the fabric itself neutral.
if(!reduced.matches){for(let n=0;n<4;n++){const progress=(ms*.00007+n*.271)%1;const i=Math.min(cols-1,Math.floor(progress*(cols-1)));const j=Math.floor(rows*(.30+n*.16));const pt=points[j][i];const glow=Math.pow(Math.sin(Math.PI*progress),2)*(.55+.45*Math.sin(p+n*2.1)**2);ctx.beginPath();ctx.arc(pt[0],pt[1],1.6+glow*.8,0,Math.PI*2);ctx.fillStyle='rgba(181,76,53,'+(glow*.65)+')';ctx.fill()}}
}
let last=0;function tick(t){scroll+=(target-scroll)*.075;visualMode+=(targetMode-visualMode)*.075;if(t-last>32){draw(t);last=t}frame=requestAnimationFrame(tick)}
const videoTimers=new WeakMap(),videoVisits=new WeakSet();
function cancelVideoStart(v){clearTimeout(videoTimers.get(v));videoTimers.delete(v)}
const videoObserver=new IntersectionObserver(entries=>{for(const entry of entries){const v=entry.target;if(!entry.isIntersecting||entry.intersectionRatio<.10||reduced.matches){cancelVideoStart(v);v.pause();videoVisits.delete(v);continue}if(entry.intersectionRatio<.25||videoVisits.has(v))continue;videoVisits.add(v);const start=()=>{videoTimers.delete(v);if(reduced.matches||!videoVisits.has(v))return;v.muted=true;v.currentTime=0;v.play().catch(()=>{})};const delay=Number(v.dataset.startDelay||0);if(delay)videoTimers.set(v,setTimeout(start,delay));else start()}},{threshold:[0,.10,.25]});
document.querySelectorAll('video[data-artwork]').forEach(v=>{videoObserver.observe(v);v.addEventListener('loadeddata',()=>{if(reduced.matches)v.pause()})});
reduced.addEventListener('change',()=>{document.querySelectorAll('video[data-artwork]').forEach(v=>{cancelVideoStart(v);v.pause();videoVisits.delete(v);videoObserver.unobserve(v);videoObserver.observe(v)})});
const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('seen');observer.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
addEventListener('resize',resize,{passive:true});addEventListener('scroll',onscroll,{passive:true});resize();onscroll();
if(!reduced.matches)frame=requestAnimationFrame(tick);
reduced.addEventListener('change',()=>{cancelAnimationFrame(frame);if(reduced.matches)draw(0);else frame=requestAnimationFrame(tick)});
})();
</script></body></html>
