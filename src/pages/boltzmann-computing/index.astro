---
// GitHub Pages does not support server-side redirects. Retain this legacy
// route for existing links and point crawlers to the new canonical address.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/physics-based-computing/`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,follow" />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <link rel="canonical" href={new URL(target, Astro.site).href} />
  <title>Moved to Physics-Based Computing — Vijoy</title>
</head>
<body>
  <p>This page has moved to <a href={target}>Physics-Based Computing</a>.</p>
</body>
</html>
