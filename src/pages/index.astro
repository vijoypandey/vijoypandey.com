---
import EnchantedV2Header from '../components/EnchantedV2Header.astro';
import EnchantedV2Footer from '../components/EnchantedV2Footer.astro';
import { activity } from '../data/site';
import { frontierPath, frontierWorlds, images, openingSlides } from '../data/enchantedV2';
import '../styles/enchanted-v2.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const artwork = (name: string) => `${base}/images/design-exploration/${name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Exploring civilization-scale computing: how collective intelligence, quantum systems, physics-native computing, and embodied intelligence can scale beyond the individual node."/>    <meta name="theme-color" content="#eee9de" />
    <title>Vijoy. — Civilization-Scale Computing</title>
    <link rel="canonical" href={new URL(`${base}/`, Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="enchanted-v2">
    <EnchantedV2Header />
    <main id="main">
      <section class="hero-slider" id="thesis" aria-label="Beyond the Bit and the four frontiers" data-hero-slider>
        <div class="hero-track">
          {openingSlides.map((slide, index) => (
            <article
              class={`hero-slide opening ${index === 0 ? 'is-active' : ''}`}
              id={`slide-panel-${index + 1}`}
              role="tabpanel"
              aria-labelledby={`slide-tab-${index + 1}`}
              aria-hidden={index !== 0}
              inert={index !== 0}
              data-slide
            >
              <div class="opening-copy">
                <p class="eyebrow">Civilization Scale Computing <span>—</span> {slide.number}</p>
                <div class="opening-title-wrap">
                  <p class="pretitle">{index === 0 ? 'Scaling the next era of computing' : slide.label}</p>
                  {index === 0 ? <h1>{slide.headline}</h1> : <h2>{slide.headline}</h2>}
                  <p class="dropcap-copy">{slide.body}</p>
                </div>
                <a class="text-link hero-enter" href={slide.slug ? `${base}${frontierPath(slide.slug)}` : '#frontiers'}>
                  {slide.slug ? 'Enter this frontier' : 'Explore the four frontiers'} <span aria-hidden="true">→</span>
                </a>
              </div>
              <figure class="opening-art">
                {slide.slug ? (
                  <a href={`${base}${frontierPath(slide.slug)}`} aria-label={`Enter ${slide.label}`}>
                    <img src={artwork(slide.image)} alt={slide.imageAlt} loading="eager" fetchpriority={index === 0 ? 'high' : 'low'} />
                  </a>
                ) : (
                  <img src={artwork(slide.image)} alt={slide.imageAlt} loading="eager" fetchpriority="high" />
                )}
                <figcaption><span>Plate {['I', 'II', 'III', 'IV', 'V'][index]}</span><span>{slide.note}</span></figcaption>
              </figure>
            </article>
          ))}
        </div>
        <div class="hero-toolbar">
          <div class="slider-navigation" aria-label="Slider controls">
            <button class="slider-arrow" type="button" data-previous aria-label="Previous slide"><span aria-hidden="true">←</span></button>
            <div class="slider-tabs" role="tablist" aria-label="Explore the five perspectives on computing">
              {openingSlides.map((slide, index) => (
                <button
                  class="slider-tab"
                  type="button"
                  role="tab"
                  id={`slide-tab-${index + 1}`}
                  aria-controls={`slide-panel-${index + 1}`}
                  aria-selected={index === 0}
                  aria-label={`Slide ${slide.number}: ${slide.label}`}
                  tabindex={index === 0 ? 0 : -1}
                  data-slide-tab
                >{slide.number}</button>
              ))}
            </div>
            <button class="slider-arrow" type="button" data-next aria-label="Next slide"><span aria-hidden="true">→</span></button>
          </div>
          <div class="slider-tools">
            <button class="slider-play" type="button" data-toggle-play aria-pressed="false" aria-label="Pause slideshow"><span data-play-label>Pause</span></button>
            <span class="slider-counter" data-slide-counter aria-live="polite">01 / 05</span>
          </div>
        </div>
        <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-slide-status>Slide 1 of 5: The central thesis</p>
      </section>

      <section class="worlds" aria-labelledby="why-now-title">
        <div class="worlds-rule"><span>The larger question</span><span>Why?</span></div>
        <div class="worlds-intro">
          <h2 id="why-now-title">Toward <em>Civilization-Scale Computing.</em></h2>
          <div class="worlds-intro-copy">
           <p>For eighty years, we've made extraordinary progress by computing with bits. We've made machines faster, connected them, and learned to scale computation across the planet.</p> 
           <p>Yet some of the problems that matter most to humanity—discovering new drugs and materials, predicting weather, understanding biological systems—still challenge the limits of what we can compute.</p>
           <p>Civilization-Scale Computing is an ambition to change that.</p>
           <p>It means extending computation beyond individual machines, eventually across planetary and perhaps interplanetary scales. But scale alone isn't the point.</p>
           <p>The goal is to expand what humanity can understand and solve, and to ensure those capabilities benefit the civilizations that create them.</p>
          </div>
        </div>
      </section>

      <section class="worlds" id="frontiers" aria-labelledby="worlds-title">
        <div class="worlds-rule"><span>Four frontiers</span><span>01—04</span></div>
        <div class="worlds-intro">
          <h2 id="worlds-title">Four frontiers.<br /><em>One theory of scale.</em></h2>
          <div class="worlds-intro-copy">
            <p>Computing has scaled in three ways: algorithmically, through better methods; vertically, through more powerful machines; and horizontally, by connecting machines into larger systems.</p>
            <p>Networks made that third dimension possible for classical computing. But the endpoints are changing. They think, entangle, move, and fluctuate.</p>
            <p>Each frontier explores a different form of computation. Each raises the same larger question: what does it take to scale beyond the individual node?</p>
            <p>Computing has scaled algorithmically through better methods, vertically through more capable machines, and horizontally through networks that make multiple machines work as one. That third axis now grows more demanding: the endpoints can think, entangle, move, and fluctuate. These four frontiers ask what it takes to coordinate richer forms of computation beyond one node.</p>
          </div>
        </div>
        <div class="world-map">
          {frontierWorlds.map((world, index) => (
            <article class={`world world--${index + 1}`}>
              <a class="world-link" href={`${base}${frontierPath(world.slug)}`}>
                <div class="world-heading">
                  <span class="world-number">Frontier {world.index} / 04</span>
                  <h3>{world.name}</h3>
                  <p>{world.subtitle}</p>
                </div>
                <figure class="world-figure">
                  <img src={artwork(world.image)} alt={world.imageAlt} loading="eager" decoding="async" />
                  <figcaption><span>Plate {['II', 'III', 'IV', 'V'][index]}</span><span>{world.note}</span></figcaption>
                </figure>
                <span class="world-enter">Enter this frontier <span aria-hidden="true">→</span></span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="worlds" aria-labelledby="network-role-title">
        <div class="worlds-rule"><span>The deeper question</span><span>Beyond transport</span></div>
        <div class="worlds-intro">
          <h2 id="network-role-title">Beyind the <em>individual node.</em></h2>
          <div class="worlds-intro-copy">
          <p>Connecting machines was one of computing's great breakthroughs. It let us distribute information, coordinate work, and build systems far more capable than any individual computer.</p>
          <p>But connecting the next generation of computing systems presents different challenges.</p>
          <p>Intelligent agents must share meaning and intent. Quantum systems must establish entanglement across distance. Physical computing systems must preserve useful dynamics when coupled. Embodied intelligence must coordinate perception and action in a changing world.</p>
          <p>These are not simply problems of moving information. They require new approaches to distributed systems—across networking, protocols, state, synchronization, and coordination.</p>
          <p>Every distributed system must answer a fundamental question: <em>what state must survive the boundary?</em></p>
          </div>
        </div>
      </section>

      <section class="activity" id="activity" aria-labelledby="activity-title">
        <div class="activity-intro">
          <p class="eyebrow">A continuing record <span>—</span> 05</p>
          <h2 id="activity-title">Recent <em>activity.</em></h2>
          <p>Following the science, the experiments, and the conversations that may change how we compute together.</p>
        </div>
        <div class="activity-list">
          {activity.map((item) => (
            <article class="activity-row">
              <time>{item.date}</time>
              <span class="activity-type">{item.type}</span>
              <h3>{item.title}</h3>
            </article>
          ))}
        </div>
      </section>
    </main>
    <EnchantedV2Footer />
    <script>
      const slider = document.querySelector<HTMLElement>('[data-hero-slider]');
      if (slider) {
        const panels = Array.from(slider.querySelectorAll<HTMLElement>('[data-slide]'));
        const tabs = Array.from(slider.querySelectorAll<HTMLButtonElement>('[data-slide-tab]'));
        const counter = slider.querySelector<HTMLElement>('[data-slide-counter]');
        const playButton = slider.querySelector<HTMLButtonElement>('[data-toggle-play]');
        const playLabel = slider.querySelector<HTMLElement>('[data-play-label]');
        const status = slider.querySelector<HTMLElement>('[data-slide-status]');
        let active = 0;
        let autoplayTimer: number | undefined;
        let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function stopAutoplay() {
          if (autoplayTimer !== undefined) window.clearInterval(autoplayTimer);
          autoplayTimer = undefined;
        }

        function updatePlayButton() {
          playButton?.setAttribute('aria-pressed', String(!paused));
          playButton?.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
          if (playLabel) playLabel.textContent = paused ? 'Play' : 'Pause';
        }

        function startAutoplay() {
          stopAutoplay();
          if (!paused) autoplayTimer = window.setInterval(() => showSlide(active + 1, false, false), 8000);
        }

        function showSlide(index: number, focusTab = false, restartAutoplay = true) {
          const previous = active;
          active = (index + panels.length) % panels.length;
          panels.forEach((panel, position) => {
            const selected = position === active;
            panel.classList.toggle('is-active', selected);
            panel.classList.toggle('is-leaving', position === previous && position !== active);
            panel.inert = !selected;
            panel.setAttribute('aria-hidden', String(!selected));
            tabs[position].setAttribute('aria-selected', String(selected));
            tabs[position].tabIndex = selected ? 0 : -1;
          });
          if (counter) counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(panels.length).padStart(2, '0')}`;
          if (status) status.textContent = `Slide ${active + 1} of ${panels.length}: ${tabs[active].getAttribute('aria-label')?.split(': ')[1]}`;
          if (focusTab) tabs[active].focus();
          if (restartAutoplay) startAutoplay();
        }

        slider.querySelector<HTMLButtonElement>('[data-previous]')?.addEventListener('click', () => showSlide(active - 1));
        slider.querySelector<HTMLButtonElement>('[data-next]')?.addEventListener('click', () => showSlide(active + 1));
        playButton?.addEventListener('click', () => {
          paused = !paused;
          updatePlayButton();
          if (paused) stopAutoplay();
          else startAutoplay();
        });
        window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (event) => {
          paused = event.matches;
          updatePlayButton();
          if (paused) stopAutoplay();
          else startAutoplay();
        });
        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => showSlide(index));
          tab.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowRight') { event.preventDefault(); showSlide(index + 1, true); }
            if (event.key === 'ArrowLeft') { event.preventDefault(); showSlide(index - 1, true); }
            if (event.key === 'Home') { event.preventDefault(); showSlide(0, true); }
            if (event.key === 'End') { event.preventDefault(); showSlide(tabs.length - 1, true); }
          });
        });
        let touchStartX = 0;
        slider.addEventListener('touchstart', (event) => { touchStartX = event.changedTouches[0]?.clientX ?? 0; }, { passive: true });
        slider.addEventListener('touchend', (event) => {
          const delta = (event.changedTouches[0]?.clientX ?? 0) - touchStartX;
          if (Math.abs(delta) > 45) showSlide(active + (delta < 0 ? 1 : -1));
        }, { passive: true });
        updatePlayButton();
        startAutoplay();
      }
    </script>
  </body>
</html>
