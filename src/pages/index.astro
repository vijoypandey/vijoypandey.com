---
const principles = [
  {
    number: '01',
    title: 'Clarity over noise',
    copy: 'Make the important thing obvious. Reduce the distance between a good idea and the person it is meant to help.',
  },
  {
    number: '02',
    title: 'Useful by default',
    copy: 'Work should earn its place in the world. I care about craft, but I care more about what the craft makes possible.',
  },
  {
    number: '03',
    title: 'Curiosity in motion',
    copy: 'Stay close to the questions. The best outcomes usually start with looking at a familiar problem from a new angle.',
  },
];

const projects = [
  { label: 'Selected work', title: 'Building thoughtful digital experiences', detail: 'Strategy · Design · Technology' },
  { label: 'Currently exploring', title: 'The space between people and products', detail: 'Research · Writing · Experiments' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="The personal website of Vijoy Pandey — thoughtful work at the intersection of people, products, and technology." />
    <meta name="theme-color" content="#f3f0e8" />
    <title>Vijoy Pandey — Making things matter</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Vijoy Pandey home">VP<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="intro-title">
        <p class="eyebrow">Independent builder · New Delhi / Everywhere</p>
        <h1 id="intro-title">Making things<br /><em>matter.</em></h1>
        <div class="hero-foot">
          <p class="intro">I’m Vijoy — I work with curious people to turn complex ideas into clear, useful experiences.</p>
          <a class="round-link" href="#about" aria-label="Scroll to learn more">↓</a>
        </div>
      </section>

      <section class="statement" id="about" aria-labelledby="statement-title">
        <p class="section-tag">A little about me</p>
        <h2 id="statement-title">Good work lives at the intersection of <span>insight</span> and intention.</h2>
        <p class="body-copy">I’m interested in the questions underneath the brief: what people actually need, what technology can unlock, and how the two can meet in a way that feels human. This is where I collect a few of the things I’m making, thinking about, and learning from.</p>
      </section>

      <section class="principles" aria-label="Working principles">
        {principles.map((principle) => (
          <article class="principle">
            <p class="number">{principle.number}</p>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </section>

      <section class="work" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="section-tag">In the works</p>
          <h2 id="work-title">A few open threads.</h2>
        </div>
        <div class="project-list">
          {projects.map((project, index) => (
            <article class="project-card">
              <p class="project-index">0{index + 1}</p>
              <div>
                <p class="project-label">{project.label}</p>
                <h3>{project.title}</h3>
                <p class="project-detail">{project.detail}</p>
              </div>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <p class="section-tag">Have a good question?</p>
        <h2 id="contact-title">Let’s make<br /><em>something useful.</em></h2>
        <a class="email-link" href="mailto:hello@vijoypandey.com">hello@vijoypandey.com <span>↗</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Vijoy Pandey</p>
      <a href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap');

  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f3f0e8; color: #1c1b18; font-family: 'DM Sans', sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  .site-header, .site-footer { align-items: center; display: flex; justify-content: space-between; padding: 2rem 5vw; }
  .site-header { border-bottom: 1px solid #d8d3c7; }
  .wordmark { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.08em; }
  .wordmark span { color: #d85636; }
  nav { display: flex; gap: 2.25rem; font-family: 'DM Mono', monospace; font-size: 0.68rem; text-transform: uppercase; }
  nav a, .site-footer a { transition: color 160ms ease; }
  nav a:hover, .site-footer a:hover { color: #d85636; }
  .hero, .statement, .principles, .work, .contact { padding-left: 12vw; padding-right: 12vw; }
  .hero { min-height: 77vh; padding-bottom: 6rem; padding-top: 13vh; display: flex; flex-direction: column; justify-content: space-between; }
  .eyebrow, .section-tag, .number, .project-label, .project-detail, .project-index, .site-footer { color: #6d695f; font-family: 'DM Mono', monospace; font-size: 0.67rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .eyebrow, .section-tag { margin: 0; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { font-size: clamp(4.25rem, 11vw, 10rem); font-weight: 500; letter-spacing: -0.085em; line-height: 0.88; margin: 7rem 0 0; max-width: 9ch; }
  em { color: #d85636; font-family: 'Playfair Display', serif; font-weight: 500; }
  .hero-foot { align-items: end; display: flex; justify-content: space-between; margin-top: 7rem; }
  .intro { font-size: clamp(1.1rem, 2vw, 1.5rem); letter-spacing: -0.03em; line-height: 1.25; margin: 0; max-width: 25rem; }
  .round-link { align-items: center; border: 1px solid #b7b1a4; border-radius: 100%; display: flex; font-size: 1.5rem; height: 3.75rem; justify-content: center; transition: background 180ms ease, color 180ms ease; width: 3.75rem; }
  .round-link:hover { background: #1c1b18; color: #f3f0e8; }
  .statement { background: #1c1b18; color: #f3f0e8; padding-bottom: 9rem; padding-top: 9rem; }
  .statement .section-tag, .contact .section-tag { color: #b6b0a3; }
  .statement h2, .work h2 { font-size: clamp(2.8rem, 6vw, 6rem); font-weight: 500; letter-spacing: -0.07em; line-height: 0.98; margin: 6rem 0 4rem; max-width: 12ch; }
  .statement h2 span { color: #e8e1d4; font-family: 'Playfair Display', serif; font-style: italic; }
  .body-copy { color: #b6b0a3; font-size: 1rem; line-height: 1.65; margin-left: auto; max-width: 31rem; }
  .principles { display: grid; gap: 2rem; grid-template-columns: repeat(3, 1fr); padding-bottom: 9rem; padding-top: 9rem; }
  .principle { border-top: 1px solid #b7b1a4; padding-top: 1.25rem; }
  .number { color: #d85636; }
  .principle h3 { font-size: 1.35rem; font-weight: 500; letter-spacing: -0.04em; margin: 4rem 0 1.5rem; }
  .principle > p:last-child { color: #6d695f; font-size: 0.95rem; line-height: 1.55; max-width: 18rem; }
  .work { border-top: 1px solid #d8d3c7; padding-bottom: 9rem; padding-top: 9rem; }
  .work h2 { margin-bottom: 5rem; margin-top: 2rem; }
  .project-card { align-items: center; border-top: 1px solid #b7b1a4; display: grid; gap: 2rem; grid-template-columns: 4rem 1fr auto; padding: 2rem 0; }
  .project-index, .project-label, .project-detail { margin: 0; }
  .project-label { color: #d85636; margin-bottom: 1rem; }
  .project-card h3 { font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 500; letter-spacing: -0.06em; margin-bottom: 1rem; }
  .project-detail { color: #6d695f; }
  .project-arrow { font-size: 2rem; }
  .contact { background: #d85636; color: #1c1b18; padding-bottom: 10rem; padding-top: 9rem; }
  .contact .section-tag { color: #643022; }
  .contact h2 { font-size: clamp(3.5rem, 9vw, 8rem); font-weight: 500; letter-spacing: -0.08em; line-height: 0.9; margin: 6rem 0 6rem; }
  .contact em { color: #f3f0e8; }
  .email-link { border-bottom: 1px solid #1c1b18; display: inline-flex; font-family: 'DM Mono', monospace; font-size: 0.8rem; gap: 2rem; padding-bottom: 0.75rem; text-transform: uppercase; }
  .site-footer { background: #1c1b18; color: #b6b0a3; }
  .site-footer p { margin: 0; }
  @media (max-width: 700px) {
    .site-header, .site-footer { padding: 1.5rem 7vw; }
    nav { gap: 1rem; }
    .hero, .statement, .principles, .work, .contact { padding-left: 7vw; padding-right: 7vw; }
    .hero { min-height: 80vh; padding-top: 10vh; }
    h1 { margin-top: 5rem; }
    .hero-foot { align-items: start; gap: 2rem; }
    .round-link { flex: 0 0 auto; }
    .statement, .principles, .work, .contact { padding-bottom: 6rem; padding-top: 6rem; }
    .principles { display: block; }
    .principle + .principle { margin-top: 4rem; }
    .principle h3 { margin-top: 2rem; }
    .project-card { grid-template-columns: 2.5rem 1fr auto; }
    .project-arrow { font-size: 1.5rem; }
    .site-footer { align-items: start; flex-direction: column; gap: 1rem; }
  }
</style>
