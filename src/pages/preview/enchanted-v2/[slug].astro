---
import EnchantedV2Header from '../../../components/EnchantedV2Header.astro';
import EnchantedV2Footer from '../../../components/EnchantedV2Footer.astro';
import { frontierPath, frontierWorlds, images } from '../../../data/enchantedV2';
import '../../../styles/enchanted-v2.css';
import quantum from '../../../../editorial/draft-1/quantum-computing.md?raw';
import physical from '../../../../editorial/draft-1/physical-ai.md?raw';
import boltzmann from '../../../../editorial/draft-1/boltzmann-computing.md?raw';
import about from '../../../../editorial/draft-1/about.md?raw';

const documents: Record<string,string> = {
  'quantum-computing': quantum,
  'physical-ai': physical,
  'boltzmann-computing': boltzmann,
  'about-me': about.split('# How I Work')[0],
  'how-i-work': '# How I Work' + (about.split('# How I Work')[1] || ''),
};
export function getStaticPaths() {
  return [
    'quantum-computing',
    'physical-ai',
    'boltzmann-computing',
    'about-me',
    'how-i-work',
  ].map(slug => ({ params: { slug } }));
}
const { slug } = Astro.params;
const raw = documents[slug || ''] || '';
const frontier = frontierWorlds.find(world => world.slug === slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/preview/enchanted-v2/`;
const artwork = (name: string) => `${base}/images/design-exploration/${name}`;
const escapeHTML = (value: string) => value.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const lines = raw.split(/\r?\n/);
const blocks: {tag:string; text:string}[] = [];
let paragraph: string[] = [];
function flush() { if (paragraph.length) {blocks.push({tag:'p',text:paragraph.join(' ')});paragraph=[];} }
for (const line of lines) {
 const trimmed = line.trim();
 if (!trimmed) {flush();continue;}
 if (trimmed.startsWith('### ')) {flush();blocks.push({tag:'h3',text:trimmed.slice(4)});}
 else if (trimmed.startsWith('## ')) {flush();blocks.push({tag:'h2',text:trimmed.slice(3)});}
 else if (trimmed.startsWith('# ')) {flush();blocks.push({tag:'h1',text:trimmed.slice(2)});}
 else if (trimmed.startsWith('- ')) {flush();blocks.push({tag:'li',text:trimmed.slice(2)});}
 else paragraph.push(trimmed);
}
flush();
const title = blocks.find(x=>x.tag==='h1')?.text || 'Vijoy Pandey';
---
<!doctype html>
<html lang="en">
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="theme-color" content="#eee9de"/>
 <meta name="description" content={`An evolving exploration by Vijoy Pandey: ${title}.`}/>
 <title>{title} — Vijoy Pandey</title>
 <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}/>
</head>
<body class="enchanted-v2">
 <EnchantedV2Header/>
 <main id="main">
  <section class="worlds" aria-labelledby="page-title">
   <div class="worlds-rule"><span>{frontier ? 'Four frontiers' : 'About'}</span><span>{frontier?.index ?? '—'}</span></div>
   <div class="worlds-intro">
     <h1 id="page-title">{title}</h1>
     <p>{frontier?.question ?? (slug === 'about-me' ? 'An engineer, a set of questions, and a lifetime of learning.' : 'How ideas become working systems and better teams.')}</p>
   </div>
   {frontier && <figure class="revisiting-art"><img src={artwork(frontier.folioImage)} alt={frontier.folioAlt} loading="eager"/><figcaption><span>From the frontier</span><span>{frontier.note}</span></figcaption></figure>}
  </section>
  <section class="activity" aria-label="Editorial exploration">
    <div class="activity-intro"><p class="eyebrow">An evolving inquiry</p><h2>Ideas and <em>questions.</em></h2></div>
    <div class="activity-list">
     {blocks.filter((block,index) => !(index===0 && block.tag==='h1')).map(block => (
       <article class="activity-row">
       {block.tag==='h2' ? <h2>{block.text}</h2> : block.tag==='h3' ? <h3>{block.text}</h3> : block.tag==='li' ? <p>— {block.text}</p> : block.tag==='h1' ? <h2>{block.text}</h2> : <p>{block.text}</p>}
       </article>
     ))}
    </div>
  </section>
  {frontier && <section class="worlds" aria-label="Other frontiers">
    <div class="worlds-rule"><span>Keep exploring</span><span>01—04</span></div>
    <div class="worlds-intro">
      {frontierWorlds.filter(w=>w.slug!==slug).map(world=><p><a class="text-link" href={`${base}${frontierPath(world.slug)}`}>{world.name} →</a></p>)}
    </div>
  </section>}
 </main>
 <EnchantedV2Footer/>
</body>
</html>
