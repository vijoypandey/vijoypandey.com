---
import { activity, exploring, frontiers, revisiting, thesis } from '../../../data/site';

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Characterful minimalism prototype for vijoypandey.com" />
    <title>Vijoy Pandey — Minimal prototype</title>
  </head>
  <body>
    <header><a class="logo" href={`${base}/preview/minimal/`}>vijoy<span>:</span></a><nav aria-label="Main navigation"><a href="#thesis">Thesis</a><a href="#about">About</a></nav><span class="menu-dot">●</span></header>
    <main>
      <section class="hero" id="thesis"><div class="hero-top"><span>Index / 00</span><span>Independent research</span></div><div class="hero-content"><p class="hello">Hi, I’m Vijoy.</p><h1>We need<br /><span>better</span><br />networks.</h1><p class="hero-body">{thesis.body}</p><a class="jump" href="#frontiers"><span>See what I’m exploring</span><b>↘</b></a></div><div class="side-note">The network historically scaled data.<br />Endpoints now think, fluctuate,<br />entangle, and move.</div></section>
      <section class="frontiers" id="frontiers"><div class="intro-line"><span>01 / The thesis in four parts</span><span>Drag your attention ↓</span></div><h2>Four ways to<br /><i>leave the node.</i></h2><div class="frontier-grid">{frontiers.map((frontier, index) => <a href="#exploring" class={`frontier f-${index + 1}`}><span class="number">{frontier.index}</span><div class="frontier-symbol">{frontier.mark}</div><h3>{frontier.name}</h3><p>{frontier.subtitle}</p><span class="plus">+</span></a>)}</div></section>
      <section class="now" id="exploring"><div class="now-head"><span>02 / Currently exploring</span><span class="scribble">(things in motion)</span></div><h2>Fresh<br /><i>signals.</i></h2><div class="cards">{exploring.map((item, index) => <article class={`card card-${index + 1}`}><div class="card-image"><span>{item.type}</span><i aria-hidden="true">{index === 0 ? '✳' : index === 1 ? '◉' : '↗'}</i></div><p>{item.detail}</p><h3>{item.title}</h3><a href="#activity">Take a look →</a></article>)}</div></section>
      <section class="revisit"><div><span class="section-label">03 / Worth revisiting</span><h2>{revisiting.title}</h2><p>{revisiting.detail}</p><a href="#activity">Open this thread ↗</a></div><div class="revisit-figure"><span>still<br />useful</span><b>?</b></div></section>
      <section class="recent" id="activity"><div class="recent-title"><span class="section-label">04 / Recent activity</span><h2>A short<br /><i>history.</i></h2></div><div class="recent-list">{activity.map((item) => <a href="#top"><span>{item.date}</span><b>{item.type}</b><strong>{item.title}</strong><i>↗</i></a>)}</div></section>
    </main>
    <footer id="about"><div><a href="#top">Vijoy Pandey ↗</a><p>Personal / Work / Contact</p></div><span>Make it matter.<br />© 2026</span></footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&display=swap');
  :global(*) { box-sizing: border-box; } :global(html) { scroll-behavior: smooth; } :global(body) { background: #fbfaf6; color: #20221d; font-family: 'DM Sans', sans-serif; margin: 0; } :global(a) { color: inherit; text-decoration: none; }
  header, footer { align-items: center; display: flex; font-family: 'DM Mono', monospace; font-size: .67rem; justify-content: space-between; letter-spacing: .04em; padding: 1.5rem 5vw; } header { border-bottom: 1px solid #d7d7ce; } .logo { font-family: 'DM Sans', sans-serif; font-size: 1.2rem; font-weight: 700; letter-spacing: -.08em; } .logo span { color: #e75e39; } nav { display: flex; gap: 2rem; } nav a:hover { text-decoration: underline; text-decoration-color: #e75e39; text-underline-offset: .3rem; } .menu-dot { color: #e75e39; }
  .hero { min-height: 88vh; padding: 2rem 10vw 8vw; position: relative; } .hero-top, .intro-line, .now-head, .section-label, .jump, footer { font-family: 'DM Mono', monospace; font-size: .67rem; letter-spacing: .05em; text-transform: uppercase; } .hero-top, .intro-line, .now-head { color: #7e8078; display: flex; justify-content: space-between; } .hero-content { padding: 14vh 0 0 14%; } .hello { color: #e75e39; font-size: 1rem; margin-bottom: 2rem; } h1, h2, h3, p { margin-top: 0; } h1 { font-size: clamp(5rem, 13vw, 13rem); font-weight: 700; letter-spacing: -.12em; line-height: .76; margin: 0 0 4rem; } h1 span { color: #e75e39; } .hero-body { font-size: 1.1rem; line-height: 1.35; max-width: 23rem; } .jump { align-items: center; border-bottom: 1px solid #20221d; display: flex; justify-content: space-between; margin-top: 4rem; max-width: 20rem; padding-bottom: .8rem; } .jump b { color: #e75e39; font-size: 1.3rem; font-weight: 400; } .side-note { font-family: 'DM Mono', monospace; font-size: .65rem; line-height: 1.6; position: absolute; right: 5vw; text-transform: uppercase; top: 46%; transform: rotate(-4deg); }
  .frontiers { background: #20221d; color: #fbfaf6; padding: 5vw 5vw 10vw; } .frontiers h2, .now h2, .recent h2 { font-size: clamp(4rem, 10vw, 10rem); font-weight: 700; letter-spacing: -.12em; line-height: .77; margin: 5rem 0 7rem; } .frontiers h2 i, .now h2 i, .recent h2 i { color: #e75e39; font-style: normal; } .frontier-grid { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); } .frontier { border: 1px solid #555950; display: flex; flex-direction: column; min-height: 26rem; padding: 1rem; position: relative; transition: background .2s, color .2s; } .frontier:hover { background: #e75e39; border-color: #e75e39; color: #20221d; } .number { color: #b9bcb0; font-family: 'DM Mono', monospace; font-size: .65rem; } .frontier-symbol { align-items: center; display: flex; flex: 1; font-size: 8rem; font-weight: 400; justify-content: center; line-height: 1; } .frontier h3 { font-size: 1.4rem; letter-spacing: -.06em; line-height: .9; margin: 0 0 .8rem; max-width: 9ch; } .frontier p { color: #b9bcb0; font-size: .8rem; line-height: 1.35; margin: 0; max-width: 13rem; } .frontier:hover p, .frontier:hover .number { color: #20221d; } .plus { font-size: 1.4rem; position: absolute; right: 1rem; top: 1rem; }
  .now { padding: 8vw 10vw 12vw; } .now-head { color: #7e8078; } .scribble { color: #e75e39; font-family: 'DM Sans', sans-serif; font-size: .9rem; text-transform: none; transform: rotate(-5deg); } .now h2 { color: #20221d; margin-bottom: 5rem; } .cards { display: grid; gap: 1.5rem; grid-template-columns: repeat(3, 1fr); } .card { min-width: 0; } .card-2 { margin-top: 4rem; } .card-3 { margin-top: -2rem; } .card-image { align-items: center; aspect-ratio: 1 / .9; background: #ffdd65; display: flex; justify-content: center; overflow: hidden; position: relative; } .card-2 .card-image { background: #cfc4e6; } .card-3 .card-image { background: #b9ded3; } .card-image > span { font-family: 'DM Mono', monospace; font-size: .65rem; left: 1rem; position: absolute; text-transform: uppercase; top: 1rem; } .card-image i { align-items: center; border: 2px solid #20221d; border-radius: 50%; display: flex; font-size: 6rem; font-style: normal; height: 55%; justify-content: center; transform: rotate(10deg); width: 48%; } .card-2 .card-image i { border-radius: 0; transform: rotate(45deg); } .card-3 .card-image i { border-radius: 50% 10% 50% 50%; transform: rotate(-15deg); } .card > p { color: #e75e39; font-family: 'DM Mono', monospace; font-size: .66rem; margin: 1.3rem 0 .7rem; text-transform: uppercase; } .card h3 { font-size: 1.4rem; letter-spacing: -.06em; line-height: .95; margin-bottom: 1.5rem; } .card a, .revisit a { border-bottom: 1px solid #20221d; font-family: 'DM Mono', monospace; font-size: .66rem; padding-bottom: .5rem; text-transform: uppercase; }
  .revisit { align-items: center; background: #e75e39; display: grid; gap: 8vw; grid-template-columns: 1.2fr .8fr; padding: 10vw 15vw; } .revisit .section-label { color: #693022; } .revisit h2 { font-size: clamp(2.5rem, 5vw, 5rem); letter-spacing: -.1em; line-height: .84; margin: 4rem 0 1.5rem; max-width: 9ch; } .revisit p { line-height: 1.5; max-width: 20rem; } .revisit-figure { align-items: center; aspect-ratio: 1; background: #fbfaf6; display: flex; justify-content: center; position: relative; transform: rotate(4deg); } .revisit-figure span { font-family: 'DM Mono', monospace; font-size: .7rem; left: 1rem; position: absolute; top: 1rem; text-transform: uppercase; } .revisit-figure b { color: #e75e39; font-size: 13rem; font-weight: 700; line-height: 1; transform: rotate(-4deg); }
  .recent { padding: 10vw 10vw 12vw; } .recent h2 { margin-bottom: 6rem; } .recent-list { margin-left: 25%; } .recent-list a { align-items: center; border-top: 1px solid #d7d7ce; display: grid; gap: 1rem; grid-template-columns: 6rem 6rem 1fr 1rem; padding: 1.3rem 0; } .recent-list a:hover { color: #e75e39; } .recent-list span, .recent-list b, .recent-list i { color: #7e8078; font-family: 'DM Mono', monospace; font-size: .65rem; font-style: normal; font-weight: 400; text-transform: uppercase; } .recent-list strong { font-size: 1rem; font-weight: 400; letter-spacing: -.03em; } footer { background: #20221d; color: #b9bcb0; } footer a { color: #fbfaf6; font-family: 'DM Sans', sans-serif; font-size: 1rem; font-weight: 700; letter-spacing: -.06em; text-transform: none; } footer p { margin: .8rem 0 0; }
  @media (max-width: 760px) { header, footer { padding: 1.1rem 6vw; } .hero, .now, .recent { padding-left: 6vw; padding-right: 6vw; } .hero { min-height: 84vh; } .hero-content { padding: 16vh 0 0; } h1 { font-size: clamp(4.4rem, 21vw, 8rem); } .side-note { display: none; } .frontiers { padding: 12vw 6vw; } .frontiers h2, .now h2, .recent h2 { font-size: clamp(4.4rem, 20vw, 8rem); margin: 4rem 0 5rem; } .frontier-grid { grid-template-columns: repeat(2, 1fr); } .frontier { min-height: 19rem; padding: .8rem; } .frontier-symbol { font-size: 5rem; } .frontier h3 { font-size: 1.15rem; } .frontier p { font-size: .72rem; } .cards { grid-template-columns: 1fr; } .card-2, .card-3 { margin-top: 1.5rem; } .card-image { aspect-ratio: 1 / .75; } .revisit { display: block; padding: 16vw 6vw; } .revisit-figure { margin-top: 4rem; } .recent-list { margin-left: 0; } .recent-list a { grid-template-columns: 4.5rem 4.2rem 1fr; } .recent-list i { display: none; } footer { align-items: flex-start; flex-direction: column; gap: 2rem; } }
</style>
