---
import { activity, exploring, frontiers, revisiting, thesis } from '../../../data/site';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Editorial prototype for vijoypandey.com" />
    <title>Vijoy Pandey — Editorial prototype</title>
  </head>
  <body>
    <header class="masthead">
      <a class="logo" href="/preview/editorial/">VP<span> / </span>THESIS</a>
      <nav aria-label="Main navigation"><a href="#thesis">Thesis</a><a href="#about">About</a></nav>
      <span class="edition">Prototype A · 2026</span>
    </header>

    <main>
      <section class="hero" id="thesis">
        <div class="hero-meta"><span>01 — Central thesis</span><span>Research / Design / Systems</span></div>
        <div class="hero-grid">
          <p class="hero-aside">A field guide to what happens when intelligence becomes distributed, embodied, and entangled.</p>
          <div>
            <p class="eyebrow">{thesis.kicker}</p>
            <h1>{thesis.title}</h1>
            <p class="thesis-body">{thesis.body}</p>
          </div>
        </div>
        <div class="scroll-note">↓ Explore the four frontiers</div>
      </section>

      <section class="frontiers" aria-labelledby="frontiers-title">
        <div class="section-intro"><p class="eyebrow">02 — The map</p><h2 id="frontiers-title">Four frontiers,<br /><em>one direction.</em></h2></div>
        <div class="frontier-list">
          {frontiers.map((frontier) => <a class="frontier" href="#exploring"><span class="frontier-index">{frontier.index}</span><span class="frontier-name">{frontier.name}</span><span class="frontier-subtitle">{frontier.subtitle}</span><span class="frontier-arrow">↗</span></a>)}
        </div>
      </section>

      <section class="explore" id="exploring">
        <div class="section-intro dark"><p class="eyebrow">03 — Currently exploring</p><h2>What is <em>moving</em> now.</h2></div>
        <div class="media-grid">
          {exploring.map((item) => <article class={`media-card ${item.tone}`}><div class="media-image"><span>{item.type}</span><i aria-hidden="true"></i></div><p class="card-type">{item.type}</p><h3>{item.title}</h3><p class="card-detail">{item.detail}</p></article>)}
        </div>
      </section>

      <section class="revisit"><div class="revisit-copy"><p class="eyebrow">04 — {revisiting.type}</p><h2>{revisiting.title}</h2><p>{revisiting.detail}</p><a class="text-link" href="#activity">Read the essay ↗</a></div><div class="revisit-art" aria-label="Abstract placeholder artwork"><span>ARCHIVE<br />/ 001</span><b>◒</b></div></section>

      <section class="activity" id="activity"><div class="activity-heading"><p class="eyebrow">05 — Recent activity</p><h2>A living record.</h2></div><div class="activity-list">{activity.map((item) => <a class="activity-row" href="#top"><time>{item.date}</time><span class="activity-type">{item.type}</span><span>{item.title}</span><b>↗</b></a>)}</div></section>
    </main>

    <footer id="about"><span>Vijoy Pandey</span><span>Personal / Work / Contact</span><span>© 2026</span></footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500&family=Playfair+Display:ital,wght@0,500;1,500&display=swap');
  :global(*) { box-sizing: border-box; } :global(html) { scroll-behavior: smooth; } :global(body) { background: #f1efe9; color: #171614; font-family: 'DM Sans', sans-serif; margin: 0; } :global(a) { color: inherit; text-decoration: none; }
  .masthead, footer { align-items: center; border-bottom: 1px solid #bdb8ae; display: flex; font-family: 'DM Mono', monospace; font-size: .66rem; justify-content: space-between; letter-spacing: .06em; padding: 1.25rem 5vw; text-transform: uppercase; } nav { display: flex; gap: 2rem; } nav a:hover, .text-link:hover { color: #c84a2f; } .logo { font-weight: 500; } .logo span { color: #c84a2f; } .edition { color: #77736b; }
  .hero, .frontiers, .explore, .revisit, .activity { padding: 2rem 10vw 10vw; } .hero { min-height: 83vh; padding-top: 3rem; } .hero-meta, .eyebrow, .scroll-note, .card-type, .card-detail, .activity-row, footer { font-family: 'DM Mono', monospace; font-size: .68rem; letter-spacing: .05em; text-transform: uppercase; } .hero-meta { border-bottom: 1px solid #bdb8ae; display: flex; justify-content: space-between; padding-bottom: 1rem; } .hero-grid { display: grid; gap: 9vw; grid-template-columns: 1fr 2.5fr; padding-top: 13vh; } .hero-aside { color: #77736b; font-size: .92rem; line-height: 1.55; max-width: 12rem; padding-top: 1rem; } .eyebrow { color: #c84a2f; margin: 0; } h1, h2, h3, p { margin-top: 0; } h1 { font-family: 'Playfair Display', serif; font-size: clamp(4rem, 10vw, 10rem); font-weight: 500; letter-spacing: -.075em; line-height: .86; margin: 2rem 0 4rem; max-width: 8ch; } em { font-family: 'Playfair Display', serif; font-weight: 500; } .thesis-body { font-size: clamp(1.05rem, 1.8vw, 1.45rem); line-height: 1.35; max-width: 32rem; } .scroll-note { border-top: 1px solid #bdb8ae; color: #77736b; margin-top: 11vh; padding-top: 1rem; }
  .frontiers { background: #171614; color: #f1efe9; padding-bottom: 12vw; padding-top: 10vw; } .section-intro { display: grid; gap: 3rem; grid-template-columns: 1fr 2.5fr; } .section-intro.dark { display: block; } h2 { font-size: clamp(3rem, 6.5vw, 7rem); font-weight: 400; letter-spacing: -.075em; line-height: .9; margin: 4rem 0 6rem; } .frontier-list { margin-left: 25%; } .frontier { align-items: baseline; border-top: 1px solid #55514b; display: grid; gap: 1rem; grid-template-columns: 3rem 1.3fr 1fr 2rem; padding: 1.5rem 0; transition: color .2s, padding .2s; } .frontier:hover { color: #e66a4c; padding-left: .7rem; } .frontier-index, .frontier-subtitle { color: #8e8980; font-family: 'DM Mono', monospace; font-size: .67rem; } .frontier-name { font-size: clamp(1.3rem, 2.5vw, 2.4rem); letter-spacing: -.05em; } .frontier-arrow { text-align: right; }
  .explore { background: #e2dfd6; } .explore h2 { margin-bottom: 4rem; } .media-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(3, 1fr); } .media-card { min-width: 0; } .media-image { align-items: center; aspect-ratio: 4 / 3; display: flex; justify-content: center; overflow: hidden; position: relative; } .media-image span { color: rgba(255,255,255,.75); font-family: 'DM Mono', monospace; font-size: .65rem; position: absolute; right: 1rem; top: 1rem; text-transform: uppercase; z-index: 2; } .media-image i { border: 1px solid rgba(255,255,255,.6); border-radius: 100%; display: block; height: 48%; position: relative; transform: rotate(22deg); width: 48%; } .orange .media-image { background: #c84a2f; } .orange .media-image i { border-radius: 42% 58% 55% 45%; height: 58%; width: 58%; } .violet .media-image { background: #62516f; } .violet .media-image i { border-radius: 0; transform: rotate(45deg); } .blue .media-image { background: #4a6e75; } .blue .media-image i { border-radius: 50% 50% 5% 50%; transform: rotate(-20deg); } .card-type { color: #c84a2f; margin: 1.4rem 0 .7rem; } .media-card h3 { font-size: 1.35rem; font-weight: 400; letter-spacing: -.04em; margin-bottom: .8rem; } .card-detail { color: #77736b; margin: 0; }
  .revisit { align-items: center; background: #f1efe9; display: grid; gap: 10vw; grid-template-columns: 1.15fr 1fr; padding-bottom: 12vw; padding-top: 12vw; } .revisit h2 { margin: 3rem 0 1.5rem; max-width: 10ch; } .revisit-copy > p:not(.eyebrow) { color: #77736b; line-height: 1.55; max-width: 22rem; } .text-link { border-bottom: 1px solid #171614; display: inline-block; font-family: 'DM Mono', monospace; font-size: .7rem; margin-top: 2rem; padding-bottom: .5rem; text-transform: uppercase; } .revisit-art { align-items: center; aspect-ratio: 1 / 1; background: #c84a2f; color: #f1efe9; display: flex; justify-content: center; position: relative; } .revisit-art span { font-family: 'DM Mono', monospace; font-size: .7rem; left: 1rem; position: absolute; top: 1rem; } .revisit-art b { font-size: 11rem; font-weight: 400; line-height: 1; transform: rotate(-20deg); }
  .activity { background: #171614; color: #f1efe9; padding-bottom: 11vw; padding-top: 10vw; } .activity h2 { margin: 3rem 0 5rem; } .activity-list { margin-left: 25%; } .activity-row { align-items: center; border-top: 1px solid #55514b; display: grid; gap: 1rem; grid-template-columns: 7rem 7rem 1fr 1rem; padding: 1.25rem 0; } .activity-row:hover { color: #e66a4c; } .activity-row time, .activity-type { color: #8e8980; } .activity-row span:not(.activity-type) { font-family: 'DM Sans', sans-serif; font-size: 1rem; letter-spacing: -.02em; text-transform: none; } footer { background: #171614; border-top: 1px solid #55514b; border-bottom: 0; color: #8e8980; }
  @media (max-width: 700px) { .masthead, footer { padding: 1rem 6vw; } .edition { display: none; } .hero, .frontiers, .explore, .revisit, .activity { padding-left: 6vw; padding-right: 6vw; } .hero { min-height: 78vh; padding-top: 2rem; } .hero-meta span:last-child, .hero-aside { display: none; } .hero-grid, .section-intro, .revisit { display: block; } .hero-grid { padding-top: 15vh; } h1 { font-size: clamp(3.6rem, 16vw, 6rem); margin-bottom: 3rem; } .section-intro h2 { margin: 3rem 0 4rem; } .frontier-list, .activity-list { margin-left: 0; } .frontier { grid-template-columns: 2rem 1fr 1.4rem; } .frontier-subtitle { display: none; } .media-grid { grid-template-columns: 1fr; } .media-card + .media-card { margin-top: 1.5rem; } .revisit-art { margin-top: 4rem; } .activity-row { grid-template-columns: 5rem 5rem 1fr; } .activity-row b { display: none; } footer { align-items: flex-start; flex-direction: column; gap: .7rem; } }
</style>
