---
import { activity, exploring, frontiers, revisiting, thesis } from '../../../data/site';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Visual atlas prototype for vijoypandey.com" />
    <title>Vijoy Pandey — Visual atlas prototype</title>
  </head>
  <body>
    <header><a class="brand" href="/preview/atlas/">V/ATLAS</a><nav aria-label="Main navigation"><a href="#thesis">Thesis</a><a href="#about">About</a></nav><span class="coordinates">28°36'36.0"N / 77°13'48.0"E</span></header>
    <main>
      <section class="hero" id="thesis"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-copy"><p class="label">Field notes / 001</p><h1>Beyond<br /><span>the node</span></h1><p class="hero-thesis">{thesis.body}</p><a class="enter" href="#frontiers">Enter the atlas <b>↓</b></a></div><div class="hero-legend"><span>COGNITION</span><span>NETWORK</span><span>STATE</span></div></section>
      <section class="map" id="frontiers"><div class="map-header"><p class="label">Four research frontiers</p><p>Not destinations. Coordinates.</p></div><div class="map-grid">{frontiers.map((frontier, index) => <a class={`map-card map-${index + 1}`} href="#exploring"><span class="map-number">{frontier.index}</span><div class="glyph">{frontier.mark}</div><h2>{frontier.name}</h2><p>{frontier.subtitle}</p><span class="map-link">Trace path →</span></a>)}</div></section>
      <section class="exploring" id="exploring"><div class="section-stamp"><span>Current signal</span><b>02 / 04</b></div><div class="explore-intro"><p class="label">Currently exploring</p><h2>Signals from<br /><i>the field.</i></h2></div><div class="signal-stack">{exploring.map((item, index) => <article class={`signal signal-${index + 1}`}><div class="signal-image"><span>{String(index + 1).padStart(2, '0')}</span><b>{item.type}</b><i></i></div><div class="signal-copy"><p class="label">{item.type} / {item.detail}</p><h3>{item.title}</h3><a href="#activity">Open signal ↗</a></div></article>)}</div></section>
      <section class="archive"><div class="archive-art"><span class="stamp">ARCHIVE / 017</span><div class="rings"></div><b>∞</b></div><div class="archive-copy"><p class="label">Worth revisiting</p><h2>{revisiting.title}</h2><p>{revisiting.detail}</p><a href="#activity">Read from the archive ↗</a></div></section>
      <section class="log" id="activity"><div class="log-title"><p class="label">Recent activity</p><h2>Dispatches<br /><i>in motion.</i></h2></div><div class="log-list">{activity.map((item) => <a href="#top"><time>{item.date}</time><span>{item.type}</span><strong>{item.title}</strong><b>↗</b></a>)}</div></section>
    </main>
    <footer id="about"><span>Vijoy Pandey / Atlas</span><span>Personal · Work · Contact</span><span>Open system / 2026</span></footer>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap');
  :global(*) { box-sizing: border-box; } :global(html) { scroll-behavior: smooth; } :global(body) { background: #e9e5d9; color: #262824; font-family: 'Space Grotesk', sans-serif; margin: 0; } :global(a) { color: inherit; text-decoration: none; }
  header, footer { align-items: center; display: flex; font-family: 'DM Mono', monospace; font-size: .65rem; justify-content: space-between; letter-spacing: .08em; padding: 1.4rem 4vw; text-transform: uppercase; } header { background: #e9e5d9; position: relative; z-index: 5; } .brand { font-size: 1rem; font-weight: 500; } nav { display: flex; gap: 2rem; } nav a:hover { color: #6d6dba; } .coordinates { color: #787b73; }
  .hero { align-items: center; background: #d5e0dc; display: flex; min-height: 88vh; overflow: hidden; padding: 8vw 10vw; position: relative; } .hero-copy { position: relative; z-index: 2; } .label, .map-header, .hero-legend, .enter, .map-link, .signal-copy a, .archive-copy a, .log-list { font-family: 'DM Mono', monospace; font-size: .66rem; letter-spacing: .07em; text-transform: uppercase; } .label { color: #6d6dba; margin: 0; } h1, h2, h3, p { margin-top: 0; } h1 { font-size: clamp(5rem, 15vw, 15rem); font-weight: 500; letter-spacing: -.11em; line-height: .74; margin: 3rem 0 4rem; } h1 span { color: #6d6dba; } .hero-thesis { font-size: clamp(1rem, 1.6vw, 1.3rem); line-height: 1.35; max-width: 25rem; } .enter { border-bottom: 1px solid #262824; display: flex; justify-content: space-between; margin-top: 4rem; max-width: 18rem; padding-bottom: .8rem; } .enter b { font-size: 1rem; font-weight: 400; } .hero-legend { bottom: 2rem; color: #787b73; display: flex; gap: 1.5rem; position: absolute; right: 4vw; } .hero-orbit { border: 1px solid rgba(109,109,186,.5); border-radius: 50%; height: 50vw; left: 42%; position: absolute; top: 10%; transform: rotate(27deg); width: 26vw; } .orbit-two { border-color: rgba(193,101,58,.45); height: 70vw; left: 55%; top: -16%; transform: rotate(-35deg); width: 20vw; }
  .map { background: #e9e5d9; padding: 5vw 4vw 10vw; } .map-header { color: #787b73; display: flex; justify-content: space-between; margin-bottom: 3rem; } .map-grid { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); } .map-card { aspect-ratio: .76; background: #c8d3cd; display: flex; flex-direction: column; padding: 1.2rem; position: relative; transition: transform .3s; } .map-card:hover { transform: translateY(-.7rem) rotate(-1deg); } .map-2 { background: #d5c4b9; } .map-3 { background: #c6c5df; } .map-4 { background: #e1c6a8; } .map-number, .map-link { font-family: 'DM Mono', monospace; font-size: .65rem; } .glyph { align-items: center; display: flex; flex: 1; font-size: 10rem; justify-content: center; line-height: 1; opacity: .75; } .map-card h2 { font-size: clamp(1.4rem, 2vw, 2.2rem); font-weight: 500; letter-spacing: -.07em; line-height: .9; margin: 0 0 .7rem; max-width: 9ch; } .map-card p { color: #5e625a; font-size: .8rem; line-height: 1.35; margin: 0 0 2rem; max-width: 16rem; } .map-link { border-top: 1px solid rgba(38,40,36,.35); padding-top: .8rem; }
  .exploring { background: #24262a; color: #e9e5d9; padding: 7vw 10vw 11vw; position: relative; } .section-stamp { color: #787b73; display: flex; font-family: 'DM Mono', monospace; font-size: .66rem; justify-content: space-between; left: 4vw; position: absolute; right: 4vw; text-transform: uppercase; top: 2rem; } .section-stamp b { color: #d5e0dc; font-weight: 400; } .explore-intro h2, .log-title h2 { font-size: clamp(4rem, 9vw, 9rem); font-weight: 500; letter-spacing: -.11em; line-height: .77; margin: 3rem 0 7rem; } .explore-intro h2 i, .log-title h2 i { color: #c9a5e0; font-weight: 400; } .signal-stack { display: grid; gap: 2rem; grid-template-columns: repeat(12, 1fr); } .signal { align-items: end; display: grid; gap: 2rem; grid-column: span 4; grid-template-rows: auto 1fr; } .signal-2 { margin-top: 7rem; } .signal-3 { margin-top: -4rem; } .signal-image { align-items: flex-end; aspect-ratio: 1 / 1.22; background: #6d6dba; display: flex; overflow: hidden; padding: 1rem; position: relative; } .signal-2 .signal-image { background: #c1653a; aspect-ratio: 1 / 1; } .signal-3 .signal-image { background: #72a29a; aspect-ratio: 1 / 1.35; } .signal-image span, .signal-image b { font-family: 'DM Mono', monospace; font-size: .65rem; position: absolute; text-transform: uppercase; top: 1rem; } .signal-image span { left: 1rem; } .signal-image b { right: 1rem; font-weight: 400; } .signal-image i { border: 1px solid rgba(233,229,217,.8); border-radius: 50%; height: 65%; position: absolute; right: -15%; top: 17%; width: 85%; } .signal-2 .signal-image i { border-radius: 0 50% 0 50%; height: 55%; transform: rotate(45deg); width: 55%; } .signal-3 .signal-image i { border-radius: 50% 0 50% 50%; transform: rotate(-25deg); } .signal-copy .label { color: #c9a5e0; margin: 1.2rem 0; } .signal-copy h3 { font-size: clamp(1.4rem, 2vw, 2rem); font-weight: 400; letter-spacing: -.06em; line-height: .95; margin-bottom: 1.5rem; } .signal-copy a, .archive-copy a { border-bottom: 1px solid #787b73; display: inline-block; padding-bottom: .5rem; }
  .archive { align-items: center; background: #e9e5d9; display: grid; gap: 10vw; grid-template-columns: 1fr 1fr; padding: 12vw 15vw; } .archive-art { align-items: center; aspect-ratio: .9; background: #c9a5e0; display: flex; justify-content: center; overflow: hidden; position: relative; } .stamp { font-family: 'DM Mono', monospace; font-size: .65rem; left: 1rem; position: absolute; top: 1rem; } .archive-art b { font-size: 13rem; font-weight: 400; position: relative; z-index: 1; } .rings { border: 1px solid #6d6dba; border-radius: 50%; height: 70%; position: absolute; transform: rotate(34deg); width: 43%; } .rings::after { border: 1px solid #6d6dba; border-radius: 50%; content: ''; inset: 15%; position: absolute; } .archive-copy h2 { font-size: clamp(2.5rem, 5vw, 5rem); font-weight: 500; letter-spacing: -.09em; line-height: .86; margin: 3rem 0 1.5rem; max-width: 9ch; } .archive-copy > p:not(.label) { color: #5e625a; line-height: 1.5; max-width: 20rem; }
  .log { background: #d5e0dc; display: grid; gap: 8vw; grid-template-columns: 1fr 1.4fr; padding: 9vw 10vw 11vw; } .log-title h2 { margin-bottom: 0; } .log-list { align-self: center; } .log-list a { align-items: center; border-top: 1px solid #9eaaa3; display: grid; gap: 1rem; grid-template-columns: 5.5rem 5rem 1fr 1rem; padding: 1.2rem 0; } .log-list a:hover { color: #6d6dba; } .log-list time, .log-list span { color: #68736d; } .log-list strong { font-family: 'Space Grotesk', sans-serif; font-size: 1rem; font-weight: 400; letter-spacing: -.03em; text-transform: none; } footer { background: #24262a; color: #90968f; }
  @media (max-width: 760px) { header, footer { padding: 1rem 6vw; } .coordinates { display: none; } .hero { min-height: 80vh; padding: 18vw 6vw; } h1 { font-size: clamp(4.2rem, 22vw, 8rem); } .hero-orbit { left: 57%; } .hero-legend { display: none; } .map { padding: 12vw 6vw; } .map-header { display: block; line-height: 2; } .map-grid { grid-template-columns: repeat(2, 1fr); } .map-card { aspect-ratio: .67; padding: .8rem; } .glyph { font-size: 6rem; } .map-card p { font-size: .72rem; } .exploring { padding: 18vw 6vw; } .section-stamp { left: 6vw; right: 6vw; } .explore-intro h2, .log-title h2 { font-size: clamp(4rem, 18vw, 7rem); margin-bottom: 5rem; } .signal-stack, .archive, .log { display: block; } .signal, .signal-2, .signal-3 { display: block; margin: 0 0 3rem; } .signal-image { aspect-ratio: 1 / .9; } .archive { padding: 18vw 6vw; } .archive-art { margin-bottom: 4rem; } .log { padding: 16vw 6vw; } .log-list { margin-top: 5rem; } .log-list a { grid-template-columns: 4rem 4rem 1fr; } .log-list b { display: none; } footer { align-items: flex-start; flex-direction: column; gap: .7rem; } }
</style>
